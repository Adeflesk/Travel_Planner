# .env.example - Environment variables template
# Copy this file to .env and fill in the values

# ============== Database ==============
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/travel_planner

# ============== Authentication ==============
# Generate a strong secret key: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-super-secret-key-change-this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============== CORS ==============
# Frontend URL for CORS (comma-separated for multiple)
FRONTEND_URL=http://localhost:3000
# Additional CORS origins (optional, comma-separated)
CORS_ORIGINS=

# ============== Environment ==============
# Options: development, staging, production
ENVIRONMENT=development

# ============== Weather API ==============
# OpenWeatherMap API key (get from openweathermap.org)
# Sign up at: https://openweathermap.org/api
# Free tier: 1000 calls/day, 60 calls/minute
OPENWEATHER_API_KEY=your-api-key-here

# Cache duration in seconds (default: 6 hours)
WEATHER_CACHE_TTL=21600

# ============== Geocoding ==============
# Mapbox public token for server-side geocoding (get from mapbox.com)
# Sign up at: https://account.mapbox.com/
MAPBOX_TOKEN=pk.your-mapbox-token-here
